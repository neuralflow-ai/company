# Formspree configuration (currently not working)
VITE_FORMSPREE_CONTACT_ID=your_formspree_id

# EmailJS configuration (working alternative)
# You need to create a free account at https://www.emailjs.com/
# Then replace these with your actual service ID and template ID
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_CONTACT_TEMPLATE=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Your email address where form submissions will be sent
VITE_RECIPIENT_EMAIL=your_email@domain.com